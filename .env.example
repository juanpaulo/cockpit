# DATA_MODE=mock runs every sensor against fixtures/ — required for local
# development and tests (the dev VM cannot reach the home network).
DATA_MODE=mock
# Comma-separated sources to keep mocked while DATA_MODE=live (optional).
MOCK_SENSORS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_TOKEN=
NOTION_TASKS_DB_ID=
NOTION_HOLDINGS_DB_ID=
NOTION_DATES_DB_ID=
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=
MARKET_DATA_API_KEY=
MARKET_DATA_PROVIDER=yahoo
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
TOKEN_ENCRYPTION_KEY=
# Bearer token the collector presents to POST /api/ingest.
INGEST_TOKEN=
# SQLite snapshot store path (optional; defaults to data/cockpit.db).
COCKPIT_DB=
